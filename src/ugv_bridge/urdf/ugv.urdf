    </visual>
    <!-- Colisión "óvalo rectangular": caja central + una rueda en cada extremo.
           Es exactamente la forma que modela el guardián de colisiones (una
           cápsula de radio radio_rueda alrededor del segmento motor->punta). -->
    <collision>
      <origin rpy="0 0 0" xyz="0.13 -0.015 0.001"/>
      <geometry>
        <box size="0.26 0.055 0.18"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.015 0.001"/>
      <geometry>
        <cylinder length="0.055" radius="0.09"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0.26 -0.015 0.001"/>
      <geometry>
        <cylinder length="0.055" radius="0.09"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <!-- TODO(CAD): tensor estimado, reemplazar con el del CAD real. -->
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="flipper_rl" type="continuous">
    <parent link="base_link"/>
    <child link="flipper_rl_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="-0.23 0.195 -0.03"/>
    <axis xyz="0 1 0"/>
    <limit effort="30.0" velocity="3.0"/>
  </joint>
  <link name="flipper_rl_link">
    <visual>
      <origin rpy="0 0 -1.5707963267948966" xyz="0 -0.015 0"/>
      <geometry>
        <mesh filename="package://ugv_bridge/meshes/flipper.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <!-- Colisión "óvalo rectangular": caja central + una rueda en cada extremo.
           Es exactamente la forma que modela el guardián de colisiones (una
           cápsula de radio radio_rueda alrededor del segmento motor->punta). -->
    <collision>
      <origin rpy="0 0 0" xyz="0.13 -0.015 0.001"/>
      <geometry>
