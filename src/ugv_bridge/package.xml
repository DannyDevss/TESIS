<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- ENCABEZADO DEL PROYECTO -->
  <name>ugv_bridge</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="benja@todo.todo">benja</maintainer>
  <license>TODO: License declaration</license>
  
<!-- FIN DE ENCABEZADO -->
  
  <!-- DEPENDENCIAS -->
  
  <depend>rclpy</depend>                    <!-- Dependencia para correr códigos python dentro de ROS -->
  <depend>sensor_msgs</depend>              <!-- Dependencia para CAN a formato msgs -->
  <depend>geometry_msgs</depend>            <!-- Dependencia que define estrucutura de datos 3D y cuaterniones -->
  <depend>std_msgs</depend>                 <!-- Dependencia estándar de mensajes simples I/O -->
  <depend>nav_msgs</depend>                 <!-- Dependencia para estimación de movimiento y mapeo -->
  <depend>diagnostic_msgs</depend>          <!-- /diagnostics: qué motores están cableados, cuáles responden y
                                             cuáles siguen fuera de lazo cerrado (panel Diagnostics de Foxglove). -->
  <!-- FIN DE DEPENDENCIAS -->
  
  <!-- El URDF se genera desde urdf/ugv.urdf.xacro + config/geometria_robot.yaml. -->
  
  <exec_depend>xacro</exec_depend>                     <!-- Preprocesador de archivos XML para conocer la orientación 
                                                        de cada pieza del robot-->
  <exec_depend>robot_localization</exec_depend>        <!-- Llama EKF ayudando para conocer posición exacta ante 
                                                        patinaje y deslizamientos -->
  <exec_depend>robot_state_publisher</exec_depend>     <!-- Publica lo preprocesado por xacro para verlo en entornos 3D -->
  <exec_depend>foxglove_bridge</exec_depend>           <!-- ÚNICA visualización del proyecto (ws://<host>:8765).
                                                        rviz2 y joint_state_publisher_gui se quitaron: eran una
                                                        segunda ventana que publicaba en los mismos tópicos de
                                                        comando que Foxglove y los dos se pisaban. -->
  <exec_depend>ros2launch</exec_depend>                <!-- -->
  <exec_depend>python3-can</exec_depend>               <!-- Modo 'can' del driver + motor_emulator (SocketCAN/vcan0). -->
  <exec_depend>python3-serial</exec_depend>            <!-- esp32_bridge_node: telemetria/comandos con el ESP32 por puerto serie -->
  <!-- politica_flippers ejecuta el .onnx entrenado en el PC. No está en los repos
       de ROS ni de Debian. Donde corra el nodo (Ubuntu 24.04):
       pip3 install - -user - -break-system-packages onnxruntime "numpy<2"
       (sin los espacios entre guiones: un comentario XML no admite dos guiones seguidos).
       NO hace falta torch ni stable-baselines3: eso vive solo en el PC. -->
  <!-- <exec_depend>python3-onnxruntime</exec_depend> -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
