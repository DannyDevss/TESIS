<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmd_description</name>
  <version>0.0.1</version>
  <description>
    Modelo CAD del UGV (ROBOT_CON_4PATAS, STEP de Autodesk Inventor)
    portado a ROS 2. Chasis, motores, 4 ruedas motrices y 4 flippers articulados.
  </description>
  <maintainer email="benjamincerda169@gmail.com">benja</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
